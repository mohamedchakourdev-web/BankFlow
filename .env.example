# Local placeholders. Replace every value before a shared or production deployment.
# Spring Boot does not load this file. Export the variables yourself.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankflow
DB_USERNAME=postgres
DB_PASSWORD=change_me

# HMAC key for access tokens. Required. At least 32 bytes. Never log this value.
# The placeholder below is not a usable production key.
JWT_SECRET=replace_with_random_value_of_at_least_32_bytes
# Access-token lifetime in seconds.
JWT_EXPIRATION=3600

SERVER_PORT=8080

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BANKFLOW_TRANSFER_TOPIC=bankflow.transfer-events
BANKFLOW_AUDIT_GROUP=bankflow-audit-consumer
BANKFLOW_NOTIFICATION_GROUP=bankflow-notification-consumer
BANKFLOW_OUTBOX_BATCH_SIZE=50
BANKFLOW_OUTBOX_POLL_INTERVAL=2000
BANKFLOW_OUTBOX_PUBLISHER_ENABLED=true

# Comma-separated browser origins. Leave empty when no browser client exists.
# A wildcard origin is rejected at startup.
BANKFLOW_ALLOWED_ORIGINS=

# Set to false to hide Swagger UI and the OpenAPI document.
# The prod profile forces both off.
BANKFLOW_API_DOCS_ENABLED=true
